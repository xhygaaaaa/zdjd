# 大模型配置（复制本文件为 .env 并填入真实值）
# 不填任何值时，系统自动运行在 mock 模式，可完整演示

# 提供商：mock（默认演示）| minimax | deepseek
LLM_PROVIDER=mock

# API 密钥
LLM_API_KEY=

# ---- 接入 MiniMax 时 ----
# LLM_PROVIDER=minimax
# LLM_API_KEY=你的minimax密钥
# LLM_BASE_URL=https://api.minimax.chat/v1
# LLM_MODEL=abab6.5s-chat

# ---- 后续切换到 DeepSeek 时 ----
# LLM_PROVIDER=deepseek
# LLM_API_KEY=你的deepseek密钥
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 生成后事实核查阈值 ----
# 证据支撑率低于 SUPPORT_THRESHOLD 时降级置信度；
# 低于 REFUSE_THRESHOLD 时隐藏回答并改判拒答。
VERIFY_SUPPORT_THRESHOLD=0.5
VERIFY_REFUSE_THRESHOLD=0.3
# mock/启发式校验噪声大，单独用更低的拒答阈值
VERIFY_HEURISTIC_REFUSE=0.15
